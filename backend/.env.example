# Backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://schedula:schedula_dev_password@localhost:5433/schedula?schema=public
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Session signing secret — REQUIRED at runtime.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Keep out of version control.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Razorpay test/live credentials — keep real values in backend/.env only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
