{
  "name": "backend",
  "version": "2.0.0",
  "description": "Schedula NestJS backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "node --env-file=.env node_modules/.bin/nest start --watch",
    "start": "node --env-file=.env dist/main",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "11.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "22.15.29",
    "@types/pg": "8.11.10",
    "prisma": "^7.10.1",
    "typescript": "5.9.3"
  }
}
