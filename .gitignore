# ── Dependencies ─────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ─────────────────────────────────────────
# Backend (NestJS)
backend/dist/
backend/coverage/

# Frontend (Next.js)
frontend/.next/
frontend/out/
frontend/build/

# ── Environment files ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── IDE / editor ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS artifacts ─────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Debug logs ───────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TypeScript incremental ───────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Misc ─────────────────────────────────────────────────
*.pem
.vercel

# Environment secrets (keep .env.example files tracked)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Prisma generated client: regenerated by npm run prisma:generate
/backend/src/generated/prisma/*
!/backend/src/generated/prisma/index.ts
